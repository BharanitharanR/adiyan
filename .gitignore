# Third-party clone (has its own git history, ~1.5GB with node_modules)
penwa/

# Node dependencies
node_modules/
package-lock.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local runtime data / logs
logs/
*.log
.wwebjs_auth*/
.wwebjs_cache/

# OS
.DS_Store

# Secrets
.env
.env.*

# Qdrant binary - not committed, rebuilt by mesh/qdrant/fetch_binary.sh
mesh/qdrant/qdrant-bin

# Qdrant drops this marker in the process's cwd on start
.qdrant-initialized
