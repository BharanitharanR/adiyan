# Third-party clone (has its own git history, ~1.5GB with node_modules)
penwa/

# Node dependencies
node_modules/
package-lock.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local runtime data / logs
logs/
*.log
.wwebjs_auth*/
.wwebjs_cache/

# OS
.DS_Store

# Secrets
.env
.env.*

# Installer build artifacts (rebuilt by installer/build_*.sh)
installer/build_venv/
installer/build/
installer/dist/
installer/*.spec
installer/dist_openwa/
installer/node-runtime/
installer/qdrant-runtime/
installer/release_stage/
installer/*.zip

# Qdrant drops this marker in the process's cwd on start
.qdrant-initialized
