# Copy this file to .env (gitignored - never commit the real one) and fill
# in your own key. mesh/lib/meta_model_client.py loads .env automatically.

# Meta Model API key, from the Model API dashboard (dev.meta.ai) -> API keys.
# Required for Wayfinder (mesh/orchestrator/wayfinder_session.py,
# wayfinder_tools.py) - every LLM call Wayfinder makes goes through
# Meta's Model API (Muse Spark), not Claude or any other model.
MODEL_API_KEY=

# Optional: override the Meta model Wayfinder calls. Defaults to
# muse-spark-1.3 if unset.
# WAYFINDER_META_MODEL=muse-spark-1.3
