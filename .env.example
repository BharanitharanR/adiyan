# Copy this file to .env (gitignored - never commit the real one) and fill
# in your own key. mesh/lib/meta_model_client.py loads .env automatically.

# Meta Model API key, from the Model API dashboard (dev.meta.ai) -> API keys.
# Required for Wayfinder (mesh/orchestrator/wayfinder_session.py,
# wayfinder_tools.py) - every LLM call Wayfinder makes goes through
# Meta's Model API (Muse Spark), not Claude or any other model.
MODEL_API_KEY=

# Optional: override the Meta model Wayfinder calls. Defaults to
# muse-spark-1.3 if unset. "muse-spark-1.3-contributor" costs less on
# pay-as-you-go in exchange for letting Meta train on the content sent/
# returned - a real tradeoff, not a free discount; fine for a demo on
# synthetic data, worth reconsidering for real customer conversations.
# WAYFINDER_META_MODEL=muse-spark-1.3-contributor

# LetsFG developer API key - real flight search/booking tool, separate
# from Meta's Model API (this is a tool call, not a model call, so it
# doesn't affect the "only Meta models at runtime" hackathon rule).
# One-time setup, done once per person, not per machine:
#   1. Register (free, no card):
#      curl -X POST https://letsfg.co/developers/api/v1/agents/register \
#        -H "Content-Type: application/json" \
#        -d '{"agent_name":"wayfinder","email":"YOUR_EMAIL_HERE"}'
#   2. Paste the returned api_key below.
# Sandbox mode (LETSFG_ENV=sandbox, the default) needs nothing else -
# free, fake data, no card, no OAuth tap, same schema as production.
# Switching LETSFG_ENV to "production" additionally requires YOU
# (never this assistant) to open the connect_url from step 1's response
# and link a real card - that's a real-money switch, flipped by a
# person, not by Wayfinder.
LETSFG_API_KEY=
LETSFG_ENV=sandbox

# Per-process safety cap on Meta Model API usage - catches a runaway
# loop or an unexpectedly expensive run before it burns real spend. A
# plain in-memory counter (mesh/lib/meta_model_client.py), not a durable
# quota: resets on restart, doesn't coordinate across multiple processes.
# 0 or unset = no limit on that dimension.
# WAYFINDER_MAX_CALLS=40
# WAYFINDER_MAX_TOKENS=200000
